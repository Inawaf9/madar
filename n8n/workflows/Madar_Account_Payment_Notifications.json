        "jsonBody": "=\n{{ JSON.stringify({\n  sender: { name: \"Madar | مدار\", email: \"madarplatform@aol.com\" },\n  to: [{ email: $json.toEmail, name: $json.fullName }],\n  subject: $json.subject,\n  htmlContent: `<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#F3F0EB;\" dir=\"rtl\"><tr><td align=\"center\" style=\"padding:32px 12px;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px;background-color:#FFFFFF;border-radius:16px;\" dir=\"rtl\">\n<tr><td align=\"center\" style=\"background-color:#FFFFFF;border-radius:16px 16px 0 0;border-bottom:3px solid #BA9077;padding:28px 24px;\">\n<img src=\"https://res.cloudinary.com/tadyisak/image/upload/f_auto,q_auto/madar-logo\" alt=\"مدار\" width=\"120\" style=\"display:block;width:120px;max-width:120px;height:auto;border:0;margin:0 auto 12px;\">\n<p style=\"margin:0;font-family:Tahoma,Arial,sans-serif;font-size:20px;font-weight:bold;color:#414C6B;\">مدار</p>\n<p style=\"margin:6px 0 0;font-family:Tahoma,Arial,sans-serif;font-size:13px;color:#BA9077;\">السكن، من منظور أوسع</p>\n</td></tr>\n<tr><td style=\"padding:32px 28px 10px;font-family:Tahoma,Arial,sans-serif;text-align:right;\">\n<p style=\"margin:0 0 18px;font-size:22px;font-weight:bold;color:#29292E;\">حسابك رجع فعّالًا</p>\n<p style=\"margin:0 0 18px;font-size:15px;line-height:1.9;color:#29292E;\">مرحبًا ${String($json.fullName || \"عزيزنا المستخدم\").replace(/[<>&\"'`]/g, \"\")}،</p>\n<p style=\"margin:0 0 20px;font-size:15px;line-height:1.9;color:#29292E;\">يسعدنا إبلاغك بأنه تم فك التعليق عن حسابك في منصة مدار، وتقدر الآن تسجّل دخولك وتستخدم خدمات المنصة من جديد.</p>\n</td></tr>\n<tr><td style=\"padding:0 28px 24px;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#F3F0EB;border-radius:10px;\" dir=\"rtl\">\n<tr><td style=\"padding:18px 20px;font-family:Tahoma,Arial,sans-serif;font-size:14px;line-height:1.9;color:#414C6B;text-align:right;\">أهلًا بعودتك إلى مدار! نساعدك تختار السكن الأقرب لحياتك واحتياجاتك.</td></tr>\n</table>\n</td></tr>\n<tr><td style=\"padding:0 28px 30px;font-family:Tahoma,Arial,sans-serif;text-align:right;\">\n<p style=\"margin:0;font-size:15px;line-height:1.9;color:#29292E;\">مع تحياتنا،<br><strong>فريق مدار</strong></p>\n</td></tr>\n<tr><td align=\"center\" style=\"border-top:1px solid #F3F0EB;padding:18px 24px 22px;font-family:Tahoma,Arial,sans-serif;\">\n<p style=\"margin:0 0 4px;font-size:13px;font-weight:bold;color:#414C6B;\">مدار</p>\n<p style=\"margin:0;font-size:12px;line-height:1.7;color:#74747C;\">هذه رسالة تلقائية لإبلاغك بتحديث حالة حسابك في مدار.</p>\n</td></tr>\n</table></td></tr></table>`\n}) }}\n",
